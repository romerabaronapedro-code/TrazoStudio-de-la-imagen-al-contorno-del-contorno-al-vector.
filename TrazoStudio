.project-card-body{padding:12px}.project-card h3{font-size:14px;margin:0 0 4px;overflow-wrap:anywhere}.project-meta{font-size:10px;color:var(--muted);margin-bottom:11px}.project-actions{display:flex;gap:6px;flex-wrap:wrap}.project-actions button{font-size:10px;padding:7px 8px;flex:1}
.project-cat-badge{display:inline-flex;align-items:center;gap:4px;font-size:9px;font-weight:800;padding:3px 7px;border-radius:999px;margin-bottom:8px;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.empty-state{grid-column:1/-1;text-align:center;padding:40px 18px;color:var(--muted);border:1px dashed #cfdaea;border-radius:13px;background:#fbfcff}.empty-state strong{display:block;color:var(--ink);font-size:14px;margin-bottom:4px}
.projects-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:14px}
.projects-toolbar .search-box{flex:1;min-width:min(100%,200px)}
.category-bar{display:flex;flex-wrap:wrap;gap:7px;align-items:center;margin-bottom:14px}
.category-chip{border:1px solid var(--line);background:#fff;border-radius:999px;padding:7px 12px;font-size:11px;font-weight:700;cursor:pointer;color:#52617b;display:inline-flex;align-items:center;gap:6px}
.category-chip strong{font-size:10px;background:#f0f4fa;border-radius:6px;padding:1px 6px;color:#172033}
.category-chip.active{background:var(--accent2);border-color:#b7ceff;color:#174cc2;box-shadow:inset 0 0 0 1px #c9dcff}
.category-chip .cat-dot{width:8px;height:8px;border-radius:50%;flex:0 0 auto}
.category-manage{display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:14px}
.category-manage .field-input{max-width:200px}
.bulk-bar{display:none;align-items:center;gap:10px;flex-wrap:wrap;padding:11px 13px;margin-bottom:14px;background:#f5f8ff;border:1px solid #d0def8;border-radius:12px}
.bulk-bar.visible{display:flex}
.bulk-bar .bulk-count{font-size:12px;font-weight:800;color:#174cc2;margin-right:auto}
#projectCategorySelect{width:min(160px,100%);min-width:110px;border:1px solid var(--line);border-radius:10px;padding:9px 10px;font:inherit;font-size:12px;color:var(--ink);background:#fff}
.calendar-layout{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:14px;align-items:start}
.calendar-main{background:#fff;border:1px solid var(--line);border-radius:15px;overflow:hidden;box-shadow:var(--shadow)}
.calendar-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:13px;border-bottom:1px solid var(--line);flex-wrap:wrap}.calendar-toolbar h2{font-size:16px;margin:0;letter-spacing:-.02em;text-transform:capitalize}.calendar-toolbar .btnrow{flex:0 0 auto}
.calendar-weekdays,.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}
.calendar-weekday{padding:9px 3px;text-align:center;font-weight:800;font-size:10px;color:var(--muted);background:#f9fbff;border-bottom:1px solid var(--line)}
.calendar-cell{min-width:0;min-height:112px;padding:6px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff;cursor:pointer;transition:background .12s}
.calendar-cell:nth-child(7n){border-right:0}.calendar-cell:hover{background:#f7faff}.calendar-cell.other-month{background:#fafbfd;color:#a7b1c2}.calendar-cell.selected{box-shadow:inset 0 0 0 2px #397cff;background:#f2f6ff}.calendar-cell.today .date-number{background:var(--accent);color:white}
.date-number{border:0;border-radius:7px;padding:3px 7px;background:transparent;display:inline-flex;font-size:11px;font-weight:800;margin-bottom:5px}.calendar-task-list{display:flex;flex-direction:column;gap:3px}.calendar-task{border-radius:5px;padding:3px 5px;font-size:9px;line-height:1.3;background:#eaf2ff;color:#174cc2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;border-left:2px solid #6c9fff}.calendar-task.done{background:#e8f7ef;color:#167044;border-left-color:#35aa72}.calendar-task.progress{background:#fff4df;color:#895400;border-left-color:#e6ac44}.calendar-task.event{background:#f2eaff;color:#6840a5;border-left-color:#9b78dc}.calendar-task-row.event-row{background:#fcfaff;padding:9px;border:1px solid #eee5fb;border-radius:9px;margin-top:7px}.event-row-actions{display:flex;gap:5px;margin-top:7px}.event-row-actions button{font-size:10px;padding:5px 7px}.event-description{display:block!important;white-space:pre-wrap;margin-top:3px}.event-form{display:flex;flex-direction:column;gap:9px}.event-form label{display:block;margin:0}.event-form .field-label{display:block}.event-form-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px}.event-form button{align-self:flex-start}.calendar-toolbar .btnrow button{font-size:11px;padding:7px 9px}
.calendar-jump{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.calendar-jump label{display:flex;align-items:center;gap:5px;margin:0;font-size:10px;color:var(--muted)}
.calendar-jump select{border:1px solid var(--line);border-radius:8px;background:#fff;padding:7px 8px;font:inherit;font-size:11px;color:var(--ink);max-width:150px}
.calendar-event-search h3{font-size:14px;margin:0 0 4px}
.calendar-search-top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.event-search-input-wrap{flex:1;min-width:min(100%,300px);max-width:520px}
