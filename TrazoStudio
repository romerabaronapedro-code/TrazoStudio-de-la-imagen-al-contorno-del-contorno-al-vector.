.event-search-result-info{min-width:0;overflow-wrap:anywhere}
.event-search-result-info strong{display:block;font-size:12px}
.event-search-result-info span{display:block;color:var(--muted);font-size:10px}
.event-search-result-actions{display:flex;gap:6px;flex:0 0 auto}
.event-search-result-actions button{font-size:10px;padding:6px 8px}
.event-search-badge{display:inline-block!important;width:max-content;border-radius:5px;padding:2px 5px;margin-top:3px;background:#fff0ee;color:#b42318!important;font-weight:800}
.calendar-task.holiday{background:#fff0ee;color:#b42318;border-left-color:#e57266}
.calendar-side{display:flex;flex-direction:column;gap:12px;position:sticky;top:72px}.calendar-side h3{font-size:14px;margin:0 0 10px}.selected-date{font-size:11px;color:var(--muted);margin-top:-6px}.assignment-form{display:flex;flex-direction:column;gap:9px}.calendar-task-row{padding:10px 0;border-top:1px solid var(--line);font-size:11px}.calendar-task-row strong{display:block;font-size:12px}.calendar-task-row span{color:var(--muted);font-size:10px}
.day-agenda{border-top:1px solid var(--line);background:#fbfcff}
