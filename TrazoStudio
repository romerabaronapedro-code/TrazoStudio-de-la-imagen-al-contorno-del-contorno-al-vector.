.project-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}
.project-card{overflow:hidden;border:1px solid var(--line);border-radius:13px;background:#fff;min-width:0;transition:transform .15s,box-shadow .15s,border-color .15s;position:relative}
.project-card:hover{transform:translateY(-2px);box-shadow:0 8px 22px #243b6b12}
.project-card.selected{border-color:#6c9fff;box-shadow:0 0 0 2px #c9dcff,0 8px 22px #243b6b12}
.project-card.bulk-mode{cursor:pointer}
.project-select{position:absolute;top:8px;left:8px;z-index:2;width:22px;height:22px;accent-color:var(--accent);cursor:pointer}
.project-thumb{height:155px;background:#f1f5fb;display:flex;align-items:center;justify-content:center;overflow:hidden;border-bottom:1px solid var(--line)}
