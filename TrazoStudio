.day-agenda[open]>summary:after{content:"−"}
.day-agenda-body{padding:0 14px 14px}
.day-agenda-meta{font-size:11px;color:var(--muted);margin:-4px 0 10px}
.event-linked-tasks{margin-top:8px;padding:8px;background:#fff;border:1px solid #e8eef8;border-radius:9px}
.event-linked-tasks h4{margin:0 0 6px;font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
.event-linked-task{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:5px 0;border-top:1px solid #eef2f8;font-size:11px}
