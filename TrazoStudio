/* Gestión de proyectos, calendario y Kanban */
.app-nav{display:flex;gap:6px;flex-wrap:wrap;padding:7px;background:#eaf0fa;border:1px solid var(--line);border-radius:14px;margin-bottom:16px;position:sticky;top:8px;z-index:50;box-shadow:0 5px 18px #243b6b0b}
