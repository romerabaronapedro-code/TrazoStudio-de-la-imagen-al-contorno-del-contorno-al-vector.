.layout{display:grid;grid-template-columns:minmax(218px,250px) minmax(0,1fr) minmax(228px,270px);gap:14px;align-items:stretch}
.panel{padding:14px;min-width:0;align-self:start}.panel-head{display:flex;align-items:center;gap:9px;padding:2px 2px 13px;border-bottom:1px solid var(--line);margin-bottom:7px}.panel-icon{display:grid;place-items:center;width:31px;height:31px;border-radius:10px;background:var(--accent2);color:var(--accent);font-size:16px}.panel-head h2{font-size:13px;margin:0;letter-spacing:-.01em}.panel-head p{margin:2px 0 0;color:var(--muted);font-size:11px}
