          </div>
          <div class="contour-control">
            <label for="threshold1"><span>Umbral inferior</span><output id="v1">60</output></label>
            <input id="threshold1" type="range" min="0" max="255" value="60" disabled>
          </div>
          <div class="contour-control">
            <label for="threshold2"><span>Umbral superior</span><output id="v2">150</output></label>
            <input id="threshold2" type="range" min="0" max="255" value="150" disabled>
          </div>
          <div class="contour-control">
            <label for="blur"><span>Suavizado</span><output id="vb">3</output></label>
            <input id="blur" type="range" min="1" max="11" step="2" value="3" disabled>
          </div>
          <div class="contour-control">
            <label for="thickness"><span>Grosor</span><output id="vt">1</output></label>
            <input id="thickness" type="range" min="1" max="5" value="1" disabled>
          </div>
          <div class="contour-control contour-invert">
