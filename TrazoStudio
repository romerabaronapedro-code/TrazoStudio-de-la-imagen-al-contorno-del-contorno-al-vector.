.selection-modes{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px;margin-bottom:7px}
.selection-modes .tool-button{padding:7px 3px!important;font-size:9px!important;min-width:0}
.selection-modes .tool-button.active{background:var(--accent2);border-color:#b7ceff;color:#174cc2}
.side-right .panel-head{padding-bottom:8px;margin-bottom:4px}
.side-left .panel-head{padding-bottom:8px;margin-bottom:4px}
@media(max-width:1180px){
  .stage{height:clamp(220px,34vh,390px);min-height:220px;padding:12px}
  .contour-controls{grid-template-columns:repeat(3,minmax(0,1fr));gap:8px 10px}
  .contour-profile{grid-column:span 1}
  .contour-invert{grid-column:span 1}
}
@media(max-width:760px){
  .stage{height:34vh;min-height:210px;padding:10px}
  .contour-dock{padding:9px}
  .contour-controls{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .contour-profile{grid-column:1/-1}
  .contour-invert{grid-column:1/-1}
  .contour-dock-top{gap:7px}
  .contour-dock-title{min-width:120px}
  #contourSettings #process{flex:1}
  .side-right .details-body{padding-left:2px;padding-right:2px}
}


/* V1.24 · el área central se estira hasta la altura de los paneles laterales */
/* V1.25 · recortes rectangulares, circulares y libres con relleno blanco exterior */
/* V1.26 · el marco del lienzo conserva sus dimensiones al hacer zoom */
@media (min-width:1181px){
  .layout{align-items:stretch!important}
  .workspace{align-self:stretch;min-height:0;height:auto;display:flex;flex-direction:column}
  /* El área de imagen tiene una base flex fija: el canvas ampliado solo provoca scroll interno. */
  .workspace>.stage{flex:1 1 0px!important;height:0!important;min-height:260px;max-height:none;min-width:0;overflow:auto;contain:size layout paint}
}
/* En pantallas pequeñas el marco también conserva un alto definido, independiente del zoom. */
@media (max-width:1180px){
  .workspace>.stage{flex:0 0 clamp(220px,34vh,390px);height:clamp(220px,34vh,390px);min-height:220px;max-height:none;overflow:auto}
}
@media (max-width:760px){
  .workspace>.stage{flex:0 0 34vh;height:34vh;min-height:210px;max-height:none}
}
/* El zoom se controla con +/−, Ajustar, 100 % y la rueda física; ocultamos el deslizador alternativo. */
#zoomRange{display:none!important}
.stage{overscroll-behavior:contain}

