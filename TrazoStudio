// ===== Calendario mensual conectado al Kanban =====
let calendarEventTypeFilter='all';
function updateCalendarPickers(y,m){
 const monthSelect=$('calendarMonthSelect'),yearSelect=$('calendarYearSelect');
 if(monthSelect)monthSelect.value=String(m);
 if(!yearSelect)return;
 const baseYear=new Date().getFullYear(),years=new Set();
 for(let year=baseYear-15;year<=baseYear+15;year++)years.add(year);
 years.add(y);
 [...events.map(ev=>ev.date),...tasks.map(t=>t.dueDate)].forEach(date=>{if(/^\d{4}-\d{2}-\d{2}$/.test(date||''))years.add(Number(date.slice(0,4)))});
 const options=[...years].sort((a,b)=>a-b).map(year=>`<option value="${year}">${year}</option>`).join('');
 if(yearSelect.innerHTML!==options)yearSelect.innerHTML=options;
 yearSelect.value=String(y);
}
function renderEventTypeSummary(year,month){
 const el=$('eventTypeSummary');if(!el)return;
 const monthPrefix=`${year}-${String(month+1).padStart(2,'0')}-`;
 const monthEvents=events.filter(ev=>(ev.date||'').startsWith(monthPrefix));
 const buttons=[{key:'all',label:'Todos los eventos',count:monthEvents.length,className:'all-events'},...EVENT_TYPES.map(type=>({key:type.key,label:type.label,count:monthEvents.filter(ev=>eventTypeOf(ev)===type.key).length,className:'type-'+type.key}))];
 el.innerHTML=buttons.map(item=>`<button type="button" class="event-count-chip ${item.className} ${calendarEventTypeFilter===item.key?'active':''}" data-event-filter="${item.key}" aria-pressed="${calendarEventTypeFilter===item.key}"><span>${item.label}</span><strong>${item.count}</strong></button>`).join('');
}
$('eventTypeSummary').addEventListener('click',e=>{const btn=e.target.closest('[data-event-filter]');if(!btn)return;calendarEventTypeFilter=btn.dataset.eventFilter||'all';renderCalendar()});

function renderCalendar(){
 if(!$('calendarGrid'))return;
 const y=calendarCursor.getFullYear(),m=calendarCursor.getMonth();
 updateCalendarPickers(y,m);
 $('calendarMonthLabel').textContent=new Date(y,m,1).toLocaleDateString('es-ES',{month:'long',year:'numeric'});
 const offset=(new Date(y,m,1).getDay()+6)%7,days=new Date(y,m+1,0).getDate(),cells=Math.ceil((offset+days)/7)*7;
 const today=localDateISO(new Date());let markup='';
 for(let i=0;i<cells;i++){
  const dayNum=i-offset+1,dayDate=new Date(y,m,dayNum),iso=localDateISO(dayDate),inMonth=dayNum>=1&&dayNum<=days;
  const dayTasks=tasks.filter(t=>t.dueDate===iso),dayEvents=events.filter(ev=>ev.date===iso).sort((a,b)=>(a.time||'').localeCompare(b.time||''));
  const visibleEvents=dayEvents.filter(ev=>calendarEventTypeFilter==='all'||eventTypeOf(ev)===calendarEventTypeFilter);
  const items=[...visibleEvents.map(ev=>({type:'event',id:ev.id,title:ev.title,time:ev.time||'',kind:'event type-'+eventTypeOf(ev)})),...dayTasks.map(t=>({type:'task',id:t.id,title:t.title,time:'',kind:t.status==='done'?'done':t.status==='inprogress'?'progress':''}))];
  markup+=`<div class="calendar-cell ${inMonth?'':'other-month'} ${iso===selectedCalendarDate?'selected':''} ${iso===today?'today':''}" data-calendar-date="${iso}"><button class="date-number" type="button" data-select-date="${iso}" aria-label="Seleccionar ${formatDate(iso)}">${dayDate.getDate()}</button><div class="calendar-task-list">${items.slice(0,4).map(item=>`<div class="calendar-task ${item.kind}" title="${escapeHTML(item.title)}">${item.type==='event'?'◆ ':'◦ '}${item.time?escapeHTML(item.time)+' · ':''}${escapeHTML(item.title)}</div>`).join('')}${items.length>4?`<span class="small-muted">+${items.length-4} más</span>`:''}</div></div>`;
 }
 $('calendarGrid').innerHTML=markup;renderSelectedDateTasks();renderCalendarEventSearch();renderEventTypeSummary(y,m);
}
function eventTaskIds(ev){return Array.isArray(ev?.taskIds)?ev.taskIds.filter(Boolean):[]}
function eventAllowsTasks(ev){if(ev&&typeof ev.allowTasks==='boolean')return ev.allowTasks;return eventTypeOf(ev)!=='festivo'&&!ev?.nationalHoliday}
function renderEventTasksPickList(selectedIds){
 const list=$('eventTasksPickList');if(!list)return;
 const selected=new Set(selectedIds||[]);
 if(!tasks.length){list.innerHTML='<p class="small-muted" style="margin:4px 0">No hay tareas en el tablero todavía. Crea alguna en Kanban.</p>';return}
 list.innerHTML=tasks.slice().sort((a,b)=>(a.title||'').localeCompare(b.title||'','es')).map(t=>`<label><input type="checkbox" data-event-task-pick="${escapeHTML(t.id)}" ${selected.has(t.id)?'checked':''}> <span>${escapeHTML(t.title)} <span class="small-muted">· ${statusLabel(t.status)}</span></span></label>`).join('');
}
function getPickedEventTaskIds(){return [...document.querySelectorAll('[data-event-task-pick]:checked')].map(el=>el.dataset.eventTaskPick)}
function syncEventTasksPickVisibility(){
 const allow=$('eventAllowTasks')?.checked!==false;
 const wrap=$('eventTasksPickWrap');if(wrap)wrap.hidden=!allow;
}
function renderSelectedDateTasks(){
 const d=new Date(selectedCalendarDate+'T12:00:00');
 if($('selectedDateTitle'))$('selectedDateTitle').textContent='Agenda · '+d.toLocaleDateString('es-ES',{weekday:'long',day:'numeric',month:'long'});
 if($('selectedDateSub'))$('selectedDateSub').textContent=(selectedCalendarDate===localDateISO(new Date())?'Hoy · ':'')+formatDate(selectedCalendarDate)+' · Despliega o contrae esta sección para ver el detalle del día.';
 const dayEvents=events.filter(ev=>ev.date===selectedCalendarDate&&(calendarEventTypeFilter==='all'||eventTypeOf(ev)===calendarEventTypeFilter)).sort((a,b)=>(a.time||'').localeCompare(b.time||''));
 const linkedTaskIdSet=new Set(dayEvents.flatMap(ev=>eventTaskIds(ev)));
 const dayTasks=tasks.filter(t=>t.dueDate===selectedCalendarDate&&!linkedTaskIdSet.has(t.id));
 if($('dayAgendaCount'))$('dayAgendaCount').textContent=`${dayEvents.length} evento${dayEvents.length===1?'':'s'} · ${dayTasks.length+linkedTaskIdSet.size} tarea${(dayTasks.length+linkedTaskIdSet.size)===1?'':'s'}`;
 const eventMarkup=dayEvents.map(ev=>{
  const project=savedProjects.find(p=>p.id===ev.projectId),type=eventTypeOf(ev);
  const allows=eventAllowsTasks(ev);
  const linked=eventTaskIds(ev).map(id=>taskById(id)).filter(Boolean);
  const linkedBlock=allows?`<div class="event-linked-tasks"><h4>Tareas adjuntas</h4>${linked.length?linked.map(t=>`<div class="event-linked-task"><span>◦ ${escapeHTML(t.title)} · ${statusLabel(t.status)}</span><button type="button" class="danger-btn" data-event-detach-task="${escapeHTML(ev.id)}" data-task-id="${escapeHTML(t.id)}">Quitar</button></div>`).join(''):'<p class="small-muted" style="margin:0">Ninguna todavía.</p>'}<div class="event-task-attach"><select data-event-attach-select="${escapeHTML(ev.id)}"><option value="">Adjuntar tarea…</option>${tasks.filter(t=>!eventTaskIds(ev).includes(t.id)).map(t=>`<option value="${escapeHTML(t.id)}">${escapeHTML(t.title)}</option>`).join('')}</select><button type="button" data-event-attach-btn="${escapeHTML(ev.id)}">Adjuntar</button></div></div>`:`<p class="small-muted" style="margin-top:6px">Este evento no admite tareas adjuntas.</p>`;
  return `<div class="calendar-task-row event-row type-${type}" data-day-event="${escapeHTML(ev.id)}"><strong>◆ ${escapeHTML(ev.title)}</strong><span>${ev.time?'A las '+escapeHTML(ev.time)+' · ':''}${eventTypeLabel(type)}${project?' · '+escapeHTML(project.name):''}${allows?' · Tareas: '+linked.length:''}</span>${ev.description?`<span class="event-description">${escapeHTML(ev.description)}</span>`:''}${linkedBlock}<div class="event-row-actions"><button type="button" data-event-edit="${escapeHTML(ev.id)}">Editar</button><button type="button" class="danger-btn" data-event-delete="${escapeHTML(ev.id)}">Eliminar</button></div></div>`;
 }).join('');
 const taskMarkup=dayTasks.length?`<div class="calendar-task-row" style="border-top:0;padding-top:4px"><strong style="font-size:11px;color:var(--muted)">Tareas con esta fecha (sin evento)</strong></div>`+dayTasks.map(t=>`<div class="calendar-task-row"><strong>◦ ${escapeHTML(t.title)}</strong><span>${statusLabel(t.status)}${t.projectId&&savedProjects.find(p=>p.id===t.projectId)?' · '+escapeHTML(savedProjects.find(p=>p.id===t.projectId).name):''}</span></div>`).join(''):'';
 $('selectedDateTasks').innerHTML=(dayEvents.length||dayTasks.length)?eventMarkup+taskMarkup:'<p class="small-muted">No hay eventos ni tareas para este día. Crea un evento a la derecha.</p>';
 if(!editingEventId&&$('eventDate'))$('eventDate').value=selectedCalendarDate;
 if($('assignmentStatus'))$('assignmentStatus').textContent='Día seleccionado: '+formatDate(selectedCalendarDate);
}
function renderCalendarEventSearch(){
 const input=$('calendarEventSearch'),container=$('calendarEventSearchResults');if(!input||!container)return;
 const query=input.value.trim().toLocaleLowerCase('es-ES');
 if(!query){container.innerHTML='<p class="small-muted">Escribe para buscar entre tus eventos y los festivos nacionales de 2026.</p>';return}
 const matches=events.filter(ev=>{
  const project=savedProjects.find(p=>p.id===ev.projectId);
  const haystack=[ev.title,ev.date,formatDate(ev.date),ev.time,ev.description,project?.name,ev.nationalHoliday?'festivo nacional':''].join(' ').toLocaleLowerCase('es-ES');
  return haystack.includes(query);
 }).sort((a,b)=>a.date.localeCompare(b.date)||(a.time||'').localeCompare(b.time||''));
 if(!matches.length){container.innerHTML='<p class="small-muted">No se encontraron eventos que coincidan con la búsqueda.</p>';return}
 container.innerHTML=`<p class="small-muted">${matches.length} resultado${matches.length===1?'':'s'}</p>`+matches.map(ev=>{
  const project=savedProjects.find(p=>p.id===ev.projectId);
  return `<div class="event-search-result"><div class="event-search-result-info"><strong>${escapeHTML(ev.title)}</strong><span>${escapeHTML(formatDate(ev.date))}${ev.time?' · '+escapeHTML(ev.time):''}${project?' · '+escapeHTML(project.name):''}</span><span class="event-type-badge type-${eventTypeOf(ev)}">${ev.nationalHoliday?'Festivo nacional':eventTypeLabel(eventTypeOf(ev))}</span></div><div class="event-search-result-actions"><button type="button" data-event-jump="${escapeHTML(ev.id)}">Ver fecha</button></div></div>`;
 }).join('');
}
