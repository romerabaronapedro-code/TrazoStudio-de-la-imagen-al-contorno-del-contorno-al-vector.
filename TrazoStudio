$('assistantClose').addEventListener('click',()=>{$('assistantPanel').hidden=true;$('assistantToggle').setAttribute('aria-expanded','false')});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('assistantPanel').hidden){$('assistantPanel').hidden=true;$('assistantToggle').setAttribute('aria-expanded','false')}});
// Dictado por voz para transcribir instrucciones al cuadro del asistente.
const assistantVoiceBtn=$('assistantVoiceBtn'),assistantVoiceStatus=$('assistantVoiceStatus'),assistantInput=$('assistantInput');
const SpeechRecognitionAPI=window.SpeechRecognition||window.webkitSpeechRecognition;
let assistantRecognition=null,assistantIsListening=false,assistantVoiceBase='',assistantVoiceHadResult=false;
function setAssistantVoiceStatus(message,state=''){assistantVoiceStatus.textContent=message;assistantVoiceStatus.dataset.state=state}
function finishAssistantVoiceButton(){assistantIsListening=false;assistantVoiceBtn.classList.remove('listening');assistantVoiceBtn.setAttribute('aria-pressed','false');assistantVoiceBtn.textContent='🎙 Dictar';assistantVoiceBtn.title='Dictar mensaje por voz'}
if(!SpeechRecognitionAPI){assistantVoiceBtn.disabled=true;assistantVoiceBtn.title='Este navegador no dispone de reconocimiento de voz';setAssistantVoiceStatus('El dictado no está disponible en este navegador. Puedes escribir el mensaje manualmente.','error')}
assistantVoiceBtn.addEventListener('click',()=>{
 if(!SpeechRecognitionAPI)return;
 if(assistantIsListening){try{assistantRecognition.stop()}catch(_){}setAssistantVoiceStatus('Finalizando dictado…');return}
 try{
  assistantRecognition=new SpeechRecognitionAPI();assistantRecognition.lang='es-ES';assistantRecognition.continuous=false;assistantRecognition.interimResults=true;assistantRecognition.maxAlternatives=1;
  assistantVoiceBase=assistantInput.value.trimEnd();assistantVoiceHadResult=false;
  assistantRecognition.onstart=()=>{assistantIsListening=true;assistantVoiceBtn.classList.add('listening');assistantVoiceBtn.setAttribute('aria-pressed','true');assistantVoiceBtn.textContent='■ Parar';assistantVoiceBtn.title='Detener el dictado';setAssistantVoiceStatus('Escuchando… habla ahora.','listening')};
  assistantRecognition.onresult=(event)=>{let finalText='',interimText='';for(let i=0;i<event.results.length;i++){const part=event.results[i][0]?.transcript||'';if(event.results[i].isFinal)finalText+=part;else interimText+=part}const recognised=(finalText+interimText).trim();if(recognised){assistantVoiceHadResult=true;assistantInput.value=assistantVoiceBase+(assistantVoiceBase&&recognised?' ':'')+recognised;assistantInput.dispatchEvent(new Event('input',{bubbles:true}));setAssistantVoiceStatus(finalText.trim()?'Transcripción recibida. Puedes seguir dictando o revisar y enviar el texto.':'Reconociendo voz…','listening')}};
  assistantRecognition.onerror=(event)=>{const messages={ 'not-allowed':'No se ha concedido permiso para usar el micrófono. Autoriza el acceso en el navegador y vuelve a intentarlo.','service-not-allowed':'El navegador ha bloqueado el servicio de reconocimiento de voz.','no-speech':'No he detectado voz. Pulsa Dictar e inténtalo de nuevo.','audio-capture':'No se encuentra un micrófono disponible.','network':'El reconocimiento de voz ha fallado por un problema de red. Puede requerir conexión a internet.','aborted':'Dictado cancelado.'};setAssistantVoiceStatus(messages[event.error]||`No se pudo completar el dictado (${event.error||'error desconocido'}).`,'error')};
  assistantRecognition.onend=()=>{finishAssistantVoiceButton();if(assistantVoiceHadResult)setAssistantVoiceStatus('Dictado finalizado. Revisa la transcripción y pulsa Enviar cuando esté lista.');else if(assistantVoiceStatus.dataset.state!=='error')setAssistantVoiceStatus('El dictado ha terminado sin texto. Vuelve a intentarlo o escribe el mensaje.')};
  assistantRecognition.start();
 }catch(error){finishAssistantVoiceButton();setAssistantVoiceStatus('No se pudo iniciar el micrófono. Comprueba los permisos del navegador y vuelve a intentarlo.','error');console.warn('Speech recognition could not start',error)}
});
$('assistantForm').addEventListener('submit',async e=>{e.preventDefault();if(assistantIsListening&&assistantRecognition){try{assistantRecognition.stop()}catch(_){}}const input=$('assistantInput'),text=input.value.trim();if(!text)return;assistantAddMessage(text,'user');input.value='';const submit=$('assistantForm').querySelector('button[type="submit"]');submit.disabled=true;try{const response=await assistantProcessMessage(text);assistantAddMessage(response,'assistant')}catch(err){console.error(err);assistantAddMessage('Ha ocurrido un error al consultar o actualizar los datos locales. No se ha confirmado ningún cambio.','assistant')}finally{submit.disabled=false;input.focus()}});
document.querySelectorAll('[data-assistant-prompt]').forEach(btn=>btn.addEventListener('click',()=>{$('assistantInput').value=btn.dataset.assistantPrompt;$('assistantInput').focus()}));

