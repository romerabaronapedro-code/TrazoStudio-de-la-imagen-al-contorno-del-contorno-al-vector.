function renderTaskProjectOptions(){const select=$('taskProject');if(!select)return;const current=select.value;select.innerHTML='<option value="">Sin proyecto</option>'+savedProjects.slice().sort((a,b)=>(a.name||'').localeCompare(b.name||'')).map(p=>`<option value="${escapeHTML(p.id)}">${escapeHTML(p.name)}</option>`).join('');if([...select.options].some(o=>o.value===current))select.value=current;const eventSelect=$('eventProject');if(eventSelect){const eventCurrent=eventSelect.value;eventSelect.innerHTML='<option value="">Sin proyecto</option>'+savedProjects.slice().sort((a,b)=>(a.name||'').localeCompare(b.name||'')).map(p=>`<option value="${escapeHTML(p.id)}">${escapeHTML(p.name)}</option>`).join('');if([...eventSelect.options].some(o=>o.value===eventCurrent))eventSelect.value=eventCurrent}renderCalendarAssignments()}
function renderTasks(){if(!$('tasks-todo'))return;const groups={todo:[],inprogress:[],done:[]};tasks.forEach(t=>(groups[t.status]||groups.todo).push(t));const today=localDateISO(new Date());for(const status of Object.keys(groups)){const arr=groups[status].sort((a,b)=>((a.dueDate||'9999').localeCompare(b.dueDate||'9999')));$('count-'+status).textContent=arr.length;$('tasks-'+status).innerHTML=arr.length?arr.map(t=>{const project=savedProjects.find(p=>p.id===t.projectId);const overdue=t.dueDate&&t.dueDate<today&&t.status!=='done';return `<article class="task-card" draggable="true" tabindex="0" aria-label="Tarea arrastrable: ${escapeHTML(t.title)}" data-task-card="${escapeHTML(t.id)}"><h3>${escapeHTML(t.title)}</h3>${t.description?`<p>${escapeHTML(t.description)}</p>`:''}<div class="task-card-meta">${t.dueDate?`<span class="task-tag ${overdue?'overdue':''}">◷ ${escapeHTML(formatDate(t.dueDate))}${overdue?' · Vencida':''}</span>`:'<span class="task-tag">Sin fecha</span>'}${project?`<span class="task-tag">▧ ${escapeHTML(project.name)}</span>`:''}</div><div class="task-card-controls"><select aria-label="Cambiar estado de ${escapeHTML(t.title)}" data-task-status="${escapeHTML(t.id)}"><option value="todo" ${t.status==='todo'?'selected':''}>Todo</option><option value="inprogress" ${t.status==='inprogress'?'selected':''}>En progreso</option><option value="done" ${t.status==='done'?'selected':''}>Hecho</option></select><button type="button" data-task-edit="${escapeHTML(t.id)}">Editar</button><button type="button" class="danger-btn" data-task-delete="${escapeHTML(t.id)}">×</button></div></article>`}).join(''):'<div class="empty-state" style="padding:22px 10px;font-size:11px">No hay tareas aquí todavía.</div>'}}
function resetTaskForm(){editingTaskId=null;$('taskForm').reset();$('taskStatus').value='todo';$('taskSaveBtn').textContent='＋ Añadir tarea';$('taskCancelBtn').hidden=true;$('taskFormNote').textContent='Las tareas y sus fechas se guardan localmente en este navegador.'}
$('taskForm').addEventListener('submit',e=>{e.preventDefault();const title=$('taskTitle').value.trim();if(!title)return;const data={title,dueDate:$('taskDueDate').value||'',projectId:$('taskProject').value||'',status:$('taskStatus').value};if(editingTaskId){const i=tasks.findIndex(t=>t.id===editingTaskId);if(i>=0)tasks[i]={...tasks[i],...data,updatedAt:new Date().toISOString()}}else tasks.push({id:'task_'+Date.now().toString(36)+'_'+Math.random().toString(36).slice(2,7),...data,createdAt:new Date().toISOString()});persistTasks();resetTaskForm();renderTasks();renderCalendar();renderCalendarAssignments()});
