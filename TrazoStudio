          <label for="colorTarget"><span>Color objetivo</span><input type="color" id="colorTarget" value="#d84035" disabled aria-label="Color objetivo de segmentación"></label>
          <button type="button" id="pickColorBtn" class="tool-button wide" disabled>🎯 Elegir color de la imagen</button>
