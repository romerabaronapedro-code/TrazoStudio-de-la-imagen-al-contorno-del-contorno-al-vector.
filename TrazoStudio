.toolbar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;padding:11px 13px;border-bottom:1px solid var(--line);background:linear-gradient(120deg,#fff,#f8faff);border-radius:16px 16px 0 0}.tabs{display:flex;gap:3px;background:#f0f4fa;border-radius:10px;padding:3px}.tabs button{border:0;background:transparent;padding:7px 11px;font-size:11px;border-radius:7px}.tabs button.active{background:white;box-shadow:0 2px 7px #172b4d13;color:var(--accent)}.view-tools{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.view-tools button{font-size:11px;padding:7px 9px}.zoom-control{display:flex;align-items:center;gap:6px;padding:3px 7px;border:1px solid var(--line);border-radius:10px;background:white}.zoom-control button{border:0;padding:4px 6px;border-radius:6px}.zoom-control input{width:86px}.zoom-value{font-size:11px;font-weight:800;color:var(--accent);min-width:36px;text-align:center;font-variant-numeric:tabular-nums}
