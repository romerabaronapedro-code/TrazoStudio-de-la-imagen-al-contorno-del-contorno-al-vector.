];
let tutorialIndex=0,tutorialActive=false,tutorialLastTarget=null;
function tutorialCloseUnlock(){$('tutorialUnlock').hidden=true;$('tutorialUnlockError').textContent='';$('tutorialCodeInput').value=''}
function tutorialOpenUnlock(){
 if($('assistantPanel')&&!$('assistantPanel').hidden){$('assistantPanel').hidden=true;$('assistantToggle').setAttribute('aria-expanded','false')}
 if(!$('shareProjectModal').hidden)closeProjectShare();
 $('tutorialUnlock').hidden=false;$('tutorialUnlockError').textContent='';$('tutorialCodeInput').value='';
 setTimeout(()=>$('tutorialCodeInput').focus(),40);
}
function tutorialEnd(){
 tutorialActive=false;document.body.classList.remove('tutorial-active');
 $('tutorialOverlay').hidden=true;$('tutorialOverlay').classList.remove('active');
 $('tutorialSpotlight').hidden=true;
 if(tutorialLastTarget){tutorialLastTarget.classList.remove('tutorial-target-pulse');tutorialLastTarget=null}
}
function tutorialPositionCard(targetRect){
 const card=$('tutorialCard'),pad=14,vw=window.innerWidth,vh=window.innerHeight;
 card.style.left='';card.style.right='';card.style.top='';card.style.bottom='';
 const cw=card.offsetWidth||400,ch=card.offsetHeight||220;
 let top,left;
 if(targetRect){
  const spaceBelow=vh-(targetRect.bottom+pad),spaceAbove=targetRect.top-pad;
  if(spaceBelow>ch+20||spaceBelow>=spaceAbove){top=Math.min(vh-ch-pad,targetRect.bottom+pad);left=Math.min(vw-cw-pad,Math.max(pad,targetRect.left))}
  else{top=Math.max(pad,targetRect.top-ch-pad);left=Math.min(vw-cw-pad,Math.max(pad,targetRect.left))}
 }else{top=Math.max(pad,(vh-ch)/2);left=Math.max(pad,(vw-cw)/2)}
 card.style.top=top+'px';card.style.left=left+'px';
}
function tutorialHighlight(selector){
 const spot=$('tutorialSpotlight');
 if(tutorialLastTarget){tutorialLastTarget.classList.remove('tutorial-target-pulse');tutorialLastTarget=null}
 if(!selector){spot.hidden=true;tutorialPositionCard(null);return null}
 const el=document.querySelector(selector);
 if(!el){spot.hidden=true;tutorialPositionCard(null);return null}
 el.scrollIntoView({behavior:'smooth',block:'center',inline:'nearest'});
 const rect=el.getBoundingClientRect(),m=8;
 spot.hidden=false;
 spot.style.top=(rect.top-m)+'px';spot.style.left=(rect.left-m)+'px';
 spot.style.width=(rect.width+m*2)+'px';spot.style.height=(rect.height+m*2)+'px';
 el.classList.add('tutorial-target-pulse');tutorialLastTarget=el;
 tutorialPositionCard(rect);
 return el;
}
function tutorialShowStep(i){
 if(i<0||i>=TUTORIAL_STEPS.length)return;
 tutorialIndex=i;
 const step=TUTORIAL_STEPS[i];
 if(step.page)switchPage(step.page);
 if(step.page==='calendar'){const agenda=$('dayAgenda');if(agenda)agenda.open=true}
 requestAnimationFrame(()=>{
  $('tutorialStepMeta').textContent=`Paso ${i+1} de ${TUTORIAL_STEPS.length}`;
  $('tutorialCardTitle').textContent=step.title;
  $('tutorialCardText').textContent=step.text;
  $('tutorialPrevBtn').disabled=i===0;
  $('tutorialNextBtn').textContent=i===TUTORIAL_STEPS.length-1?'Terminar':'Siguiente →';
  setTimeout(()=>tutorialHighlight(step.selector),80);
 });
}
function tutorialStart(){
 tutorialActive=true;document.body.classList.add('tutorial-active');
 $('tutorialOverlay').hidden=false;$('tutorialOverlay').classList.add('active');
 tutorialShowStep(0);
}
$('tutorialStartBtn').addEventListener('click',tutorialOpenUnlock);
$('tutorialUnlockCancel').addEventListener('click',tutorialCloseUnlock);
$('tutorialUnlock').addEventListener('click',e=>{if(e.target===$('tutorialUnlock'))tutorialCloseUnlock()});
$('tutorialUnlockConfirm').addEventListener('click',()=>{
 const code=($('tutorialCodeInput').value||'').trim();
 if(code!=='TUTORIAL'){$('tutorialUnlockError').textContent='Debes escribir exactamente TUTORIAL en mayúsculas.';$('tutorialCodeInput').focus();$('tutorialCodeInput').select();return}
 tutorialCloseUnlock();tutorialStart();
});
$('tutorialCodeInput').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();$('tutorialUnlockConfirm').click()}});
$('tutorialNextBtn').addEventListener('click',()=>{if(tutorialIndex>=TUTORIAL_STEPS.length-1)tutorialEnd();else tutorialShowStep(tutorialIndex+1)});
$('tutorialPrevBtn').addEventListener('click',()=>{if(tutorialIndex>0)tutorialShowStep(tutorialIndex-1)});
$('tutorialSkipBtn').addEventListener('click',tutorialEnd);
document.addEventListener('keydown',e=>{
 if(!tutorialActive)return;
 if(e.key==='Escape'){e.preventDefault();tutorialEnd();return}
 if(e.key==='ArrowRight'||e.key==='Enter'){e.preventDefault();$('tutorialNextBtn').click()}
 if(e.key==='ArrowLeft'){e.preventDefault();$('tutorialPrevBtn').click()}
});
window.addEventListener('resize',()=>{if(tutorialActive)tutorialShowStep(tutorialIndex)});

