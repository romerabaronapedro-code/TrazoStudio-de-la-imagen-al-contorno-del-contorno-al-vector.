</header>
<main>
  <nav class="app-nav" aria-label="Secciones de Trazo Studio">
    <button type="button" class="active" data-page="editor">✎ Editor principal</button>
    <button type="button" data-page="projects">▧ Proyectos</button>
    <button type="button" data-page="calendar">▦ Calendario</button>
    <button type="button" data-page="kanban">☷ Tablero Kanban</button>
  </nav>
  <section id="page-editor" class="page-view active">
  <div class="topbar" aria-label="Gestión de archivos">
    <span class="topbar-label">Archivo</span>
    <label class="file-button primary" for="file" style="margin:0">＋ Importar imagen</label>
    <input type="file" id="file" accept="image/*">
    <button id="clearProject" type="button">↺ Nuevo lienzo</button>
    <button id="undoImageAction" type="button" disabled title="Deshace la última operación sobre la imagen: recorte, eliminación, segmentación o generación de contornos">↶ Deshacer paso</button>
    <input id="projectName" type="text" maxlength="100" placeholder="Nombre del proyecto" aria-label="Nombre del proyecto que vas a guardar">
