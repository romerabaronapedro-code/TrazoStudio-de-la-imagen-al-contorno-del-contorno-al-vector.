// Asistente local para consultas y operaciones estructuradas sobre los datos guardados.
function assistantNormalize(text){return String(text||'').toLocaleLowerCase('es-ES').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[¿?¡!]/g,'').trim()}
function assistantAddMessage(text,kind='assistant'){
 const box=$('assistantMessages'),node=document.createElement('div');node.className=`assistant-msg ${kind}`;node.textContent=text;box.appendChild(node);box.scrollTop=box.scrollHeight;
}
function assistantExtractDate(text){
 const norm=assistantNormalize(text),iso=norm.match(/\b(20\d{2})-(\d{2})-(\d{2})\b/);if(iso){const date=`${iso[1]}-${iso[2]}-${iso[3]}`;return isValidISODate(date)?date:null}
 const dmy=norm.match(/\b(\d{1,2})[/.](\d{1,2})[/.](20\d{2})\b/);if(dmy){const date=`${dmy[3]}-${String(Number(dmy[2])).padStart(2,'0')}-${String(Number(dmy[1])).padStart(2,'0')}`;return isValidISODate(date)?date:null}
