 }
 else if(del){const ev=events.find(x=>x.id===del.dataset.eventDelete);if(ev&&confirm(`¿Eliminar el evento «${ev.title}»?`)){events=events.filter(x=>x.id!==ev.id);persistEvents();if(editingEventId===ev.id)resetEventForm();renderCalendar();}}
