.page-heading{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin:5px 0 17px}
.page-heading h1{font-size:23px;letter-spacing:-.04em;margin:0}.page-heading p{margin:4px 0 0;color:var(--muted);font-size:12px}
.page-panel{background:rgba(255,255,255,.96);border:1px solid var(--line);border-radius:16px;padding:16px;box-shadow:var(--shadow);min-width:0}
.field-input,.field-select,.field-textarea{width:100%;min-width:0;border:1px solid var(--line);border-radius:9px;padding:9px 10px;font:inherit;font-size:12px;color:var(--ink);background:#fff}
.field-label{display:block;margin:0 0 6px;font-size:11px;font-weight:800;color:#52617b}
.search-box{display:flex;align-items:center;gap:7px;min-width:min(100%,280px)}
